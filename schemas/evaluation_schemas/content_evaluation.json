{
    "type": "object",
    "properties": {
        "doi": {"type": "string"},
        "overall_score": {"type": "number"},
        "category_scores": {
            "type": "object",
            "description": "Scores for each category found in the extraction.",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "score": {"type": "number"},
                    "completeness": {
                        "type": "object",
                        "properties": {
                            "score": {"type": "number"},
                            "coverage_percentage": {"type": "number"},
                            "missing_information": {
                                "type": "array",
                                "items": {"type": "string"}
                            },
                            "available_in_paper": {"type": "boolean"}
                        },
                        "required": ["score", "coverage_percentage", "missing_information", "available_in_paper"]
                    },
                    "accuracy": {
                        "type": "object",
                        "properties": {
                            "score": {"type": "number"},
                            "accuracy_percentage": {"type": "number"},
                            "errors": {
                                "type": "array",
                                "items": {"type": "string"}
                            },
                            "correct_values": {"type": "number"}
                        },
                        "required": ["score", "accuracy_percentage", "errors", "correct_values"]
                    },
                    "format": {
                        "type": "object",
                        "properties": {
                            "score": {"type": "number"},
                            "compliance_percentage": {"type": "number"},
                            "format_issues": {
                                "type": "array",
                                "items": {"type": "string"}
                            }
                        },
                        "required": ["score", "compliance_percentage", "format_issues"]
                    }
                },
                "required": ["score", "completeness", "accuracy", "format"]
            }
        },
        "summary": {
            "type": "object",
            "properties": {
                "strengths": {
                    "type": "array",
                    "items": {"type": "string"},
                    "description": "List of positive aspects of the extraction"
                },
                "accuracy_issues": {
                    "type": "object",
                    "properties": {
                        "fabricated_information": {
                            "type": "array",
                            "items": {"type": "string"},
                            "description": "Values in extraction that are NOT in the paper (completely fabricated)"
                        },
                        "data_errors": {
                            "type": "array",
                            "items": {"type": "string"},
                            "description": "Values that are extracted but incorrect (wrong values, 'wrong_value' placeholders)"
                        }
                    },
                    "required": ["fabricated_information", "data_errors"]
                },
                "completeness_issues": {
                    "type": "object",
                    "properties": {
                        "missing_critical_info": {
                            "type": "array",
                            "items": {"type": "string"},
                            "description": "Important information that IS in the paper but NOT extracted"
                        }
                    },
                    "required": ["missing_critical_info"]
                },
                "format_issues": {
                    "type": "array",
                    "items": {"type": "string"},
                    "description": "Issues related to format compliance (schema violations, data type errors)"
                }
            },
            "required": ["strengths", "accuracy_issues", "completeness_issues", "format_issues"]
        }
    },
    "required": ["doi", "overall_score", "category_scores", "summary"]
}