{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "array",
    "description": "A flat list of ALL individual optical property measurements.",
    "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
            "doi", "file_path", "polymer_name", "record_type", "value", 
            "temperature", "wavelength", "thickness", "test_standard", 
            "test_method", "test_conditions", "ri_mode", "notes"
        ],
        "properties": {
            "doi": { "type": ["string", "null"], "description": "The Digital Object Identifier." },
            "file_path": { "type": ["string", "null"], "description": "The local file path or filename." },
            "polymer_name": { "type": "string", "description": "Name or ID of the polymer. Mandatory." },
            "record_type": {
                "type": "string",
                "enum": [
                    "Refractive Index (n)", "Transmittance", "Cut-off Wavelength (λ_cut)", 
                    "Maximum Absorption Wavelength (λ_max)", "Emission Wavelength (λ_em)", 
                    "Birefringence (Δn)", "Abbe Number (νd)", "Haze", "Yellow Index (YI) / Whiteness Index (WI)"
                ],
                "description": "The specific optical property."
            },
            "value": { "type": "string", "description": "The numeric value ALONG WITH ITS UNIT if applicable (e.g., '450 nm', '88 %', '1.65')." },
            "temperature": { "type": ["string", "null"], "description": "Measurement temperature if reported." },
            "wavelength": { "type": ["string", "null"], "description": "Measurement wavelength (e.g., '633 nm') or excitation wavelength ('λ_ex = 350 nm')." },
            "thickness": { "type": ["string", "null"], "description": "Film thickness (e.g., '10 μm') or solution concentration." },
            "test_standard": { "type": ["string", "null"], "description": "Standard (e.g., 'ASTM D1003' for Haze/Transmittance)." },
            "test_method": { "type": ["string", "null"], "description": "Method/Instrument (e.g., 'Ellipsometry', 'UV-Vis')." },
            "test_conditions": { "type": ["string", "null"], "description": "Criterion like '1% transmittance' for cut-off, or other states." },
            "ri_mode": { "type": ["string", "null"], "description": "Mode for RI/Birefringence (e.g., 'n_TE', 'n_TM', 'In-plane')." },
            "notes": { "type": ["string", "null"], "description": "Any extra visual context or descriptions." }
        }
    }
}