{
  "type": "ARRAY",
  "description": "List of synthesized or studied polymers extracted from the text.",
  "items": {
    "type": "OBJECT",
    "required": [
      "polymer_name",
      "polymer_type",
      "components"
    ],
    "properties": {
      "polymer_name": {
        "type": "STRING",
        "description": "Primary identifier (e.g., 'PI-1', 'PU-a')."
      },
      "polymer_type": {
        "type": "STRING",
        "description": "Chemical class (e.g., 'Polyimide', 'Polyurethane')."
      },
      "components": {
        "type": "ARRAY",
        "description": "List of monomer abbreviations.",
        "items": {
          "type": "STRING"
        }
      },
      "ratio_type": {
        "type": "STRING",
        "description": "The type of ratio presented (e.g., mole, weight, unknown)."
      },
      "ratio_values_text": {
        "type": "STRING",
        "description": "General representation of the ratio values (e.g., '50:50', '1:1')."
      },
      "feed_ratio_text": {
        "type": "STRING",
        "description": "Raw text of the feed ratio (e.g., 'MDI:BDO:PTMG = 2:1:1')."
      },
      "diamine_ratio": {
        "type": "STRING",
        "description": "Molar ratio between diamines (e.g., '70:30')."
      },
      "dianhydride_ratio": {
        "type": "STRING",
        "description": "Molar ratio between dianhydrides."
      },
      "diisocyanate_ratio": {
        "type": "STRING",
        "description": "Molar ratio between diisocyanates (e.g., 'MDI:TDI = 80:20')."
      },
      "diol_ratio": {
        "type": "STRING",
        "description": "Molar ratio between diols (e.g., 'BDO:PTMG = 1:1')."
      },
      "diacid_ratio": {
        "type": "STRING",
        "description": "Molar ratio between diacids."
      },
      "mn_value": {
        "type": "STRING",
        "description": "Number average MW with unit (e.g., '25000 g/mol', '45.5 kDa')."
      },
      "mw_value": {
        "type": "STRING",
        "description": "Weight average MW with unit (e.g., '50000 g/mol', '89.2 kDa')."
      },
      "pdi_value": {
        "type": "STRING",
        "description": "Polydispersity Index (PDI, Đ)."
      },
      "test_method": {
        "type": "STRING",
        "description": "Method used (e.g., 'GPC', 'SEC', 'Viscosity')."
      }
    }
  }
}