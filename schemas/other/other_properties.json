{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "array",
    "description": "A flat list of ALL individual physical, solution, and transport property measurements.",
    "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
            "doi", "file_path", "polymer_name", "record_type", "value", 
            "temperature", "test_standard", "test_method", "test_conditions", "notes"
        ],
        "properties": {
            "doi": { "type": ["string", "null"], "description": "The Digital Object Identifier." },
            "file_path": { "type": ["string", "null"], "description": "The local file path or filename." },
            "polymer_name": { "type": "string", "description": "Name or ID of the polymer. Mandatory." },
            "record_type": {
                "type": "string",
                "enum": [
                    "Crystallinity", "Density", "Intrinsic Viscosity", "Dynamic Viscosity", 
                    "Melt Viscosity", "Solubility", "Water Absorption / Solvent Uptake", 
                    "Gas Permeability", "Gas Separation Selectivity"
                ],
                "description": "The specific property being measured."
            },
            "value": { "type": "string", "description": "Numeric value ALONG WITH ITS UNIT (e.g., '45 %', '1.35 g/cm^3', '0.85 dL/g', '450 Barrer') or qualitative state ('Soluble', 'Insoluble')." },
            "temperature": { "type": ["string", "null"], "description": "Test temperature (e.g., '30 °C', 'Room Temperature')." },
            "test_standard": { "type": ["string", "null"], "description": "Standard used (e.g., 'ASTM D570')." },
            "test_method": { "type": ["string", "null"], "description": "Method/Instrument (e.g., 'Ubbelohde viscometer', 'Time-lag method')." },
            "test_conditions": { "type": ["string", "null"], "description": "CRITICAL: Extract Medium (Solvent: 'NMP', Gas: 'CO2', Gas Pair: 'CO2/CH4') and other physical parameters like Pressure or Time." },
            "notes": { "type": ["string", "null"], "description": "Any extra context (e.g., solution concentration '10 wt%')." }
        }
    }
}