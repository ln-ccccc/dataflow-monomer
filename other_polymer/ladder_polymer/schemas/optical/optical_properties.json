{
  "type": "array",
  "description": "A flat list of ALL individual optical property measurements for newly synthesized ladder polymers and ladder precursor materials.",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "doi",
      "file_path",
      "polymer_name",
      "record_type",
      "value",
      "temperature",
      "wavelength",
      "thickness",
      "test_standard",
      "test_method",
      "test_conditions",
      "ri_mode",
      "notes"
    ],
    "properties": {
      "doi": {
        "type": "string",
        "nullable": true,
        "description": "The Digital Object Identifier."
      },
      "file_path": {
        "type": "string",
        "nullable": true,
        "description": "The local file path or filename."
      },
      "polymer_name": {
        "type": "string",
        "description": "Name or ID of the ladder polymer or ladder precursor stage explicitly measured."
      },
      "record_type": {
        "type": "string",
        "enum": [
          "Refractive Index (n)",
          "Transmittance",
          "Cut-off Wavelength (λ_cut)",
          "Maximum Absorption Wavelength (λ_max)",
          "Emission Wavelength (λ_em)",
          "Birefringence (Δn)",
          "Abbe Number (νd)",
          "Haze",
          "Yellow Index (YI) / Whiteness Index (WI)",
          "Thickness direction Retardation (Rth)"
        ],
        "description": "The specific optical property."
      },
      "value": {
        "type": "string",
        "description": "The numeric value ALONG WITH ITS UNIT if applicable (e.g., '450 nm', '88 %', '1.65')."
      },
      "temperature": {
        "type": "string",
        "nullable": true,
        "description": "Measurement temperature if reported."
      },
      "wavelength": {
        "type": "string",
        "nullable": true,
        "description": "Measurement wavelength (e.g., '633 nm') or excitation wavelength ('λ_ex = 350 nm')."
      },
      "thickness": {
        "type": "string",
        "nullable": true,
        "description": "Film thickness (e.g., '10 μm') or solution concentration."
      },
      "test_standard": {
        "type": "string",
        "nullable": true,
        "description": "Standard (e.g., 'ASTM D1003' for Haze/Transmittance)."
      },
      "test_method": {
        "type": "string",
        "nullable": true,
        "description": "Method/Instrument (e.g., 'Ellipsometry', 'UV-Vis')."
      },
      "test_conditions": {
        "type": "string",
        "nullable": true,
        "description": "Criterion like '1% transmittance' for cut-off, or other states."
      },
      "ri_mode": {
        "type": "string",
        "nullable": true,
        "description": "Mode for RI/Birefringence (e.g., 'n_TE', 'n_TM', 'In-plane')."
      },
      "notes": {
        "type": "string",
        "nullable": true,
        "description": "Any extra visual context or descriptions. Relevant stage/context for the Ladder Polymer material may also be captured here."
      }
    }
  }
}
