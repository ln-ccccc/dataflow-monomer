{
  "title": "Polymer Monomer Extraction Schema",
  "type": "object",
  "properties": {
    "monomers_info": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["doi", "abbreviation", "full_name", "smiles"],
        "properties": {
          "doi": {
            "type": ["string", "null"],
            "description": "Main article DOI starting with '10.'. Null if not found."
          },
          "abbreviation": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Explicit monomer abbreviations used in the paper (e.g., MMA, St)."
          },
          "full_name": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Full, common, or trivial names referring to the monomer."
          },
          "iupac_name": {
            "type": ["string", "null"],
            "description": "IUPAC name if explicitly stated or confidently inferred."
          },
          "cas_no": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{2,7}-\\d{2}-\\d$"
            },
            "description": "CAS Registry Numbers associated with the monomer."
          },
          "smiles": {
            "type": "string",
            "minLength": 1,
            "description": "SMILES of the neutral monomer. Inferred if not explicitly provided."
          }
        }
      }
    }
  },
  "required": ["monomers_info"]
}
